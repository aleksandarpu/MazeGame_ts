# Settings for production. Locally none are needed. VITE_ variables can go in .env.local (git-ignored, read by Vite); server variables are read from the environment.

# --- Client (read by Vite at build time; set it in Vercel's project settings) ---
# The game server's WebSocket. Leave unset in development: the page uses /ws, which
# Vite forwards to localhost:3000.
# VITE_SERVER_URL=wss://your-server.up.railway.app/ws

# --- Server (set these in Railway's service variables) ---
# Without them the server uses a local SQLite file, data/mazegame.sqlite.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
# Page origins allowed to connect ("*" matches part of a host name):
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app
